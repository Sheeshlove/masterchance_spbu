# Пример настроек. Скопируйте в .env и подставьте свои значения:
#
#     cp .env.example .env
#
# .env лежит в .gitignore и в репозиторий не попадает. Настоящий токен
# держите ТОЛЬКО в нём: не в коде, не в README, не в переписке.

# ── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather. Кто знает токен — тот управляет ботом целиком,
# поэтому если он куда-то утёк, немедленно отзовите его: @BotFather → /revoke.
BOT_TOKEN=123456789:AA-ваш-токен-от-botfather

# Публичный адрес сайта для Telegram Mini App.
# Обязательно https:// и валидный сертификат — по http и по голому IP
# Telegram Mini App не откроет. Не задан → бот работает как обычный бот.
WEBAPP_URL=https://masterchance-bot.ru

# ── Веб-интерфейс ───────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ── Вузы ────────────────────────────────────────────────────────────────────
# Какие источники обновлять: all — все шесть (СПбГУ, ВШЭ, ИТМО, МГИМО, МГУ,
# РАНХиГС). Можно перечислить через запятую: UNIVERSITIES=spbgu,itmo
UNIVERSITIES=all

# Стартовые страницы приёмных кампаний. Пусто — берётся адрес по умолчанию
# (app/infrastructure/parser/openlists/specs.py). Разделы приёма вузы переносят
# почти каждый сезон, поэтому адрес меняется здесь, а не в коде. Проверить, что
# по адресу действительно находятся списки:
#
#     python scripts/diagnose_source.py hse
#
# HSE_LISTS_URL=https://priem45.hse.ru/magstats.html
# ITMO_LISTS_URL=
# MGIMO_LISTS_URL=
# MSU_LISTS_URL=
# RANEPA_LISTS_URL=

# Предохранитель: сколько списков максимум брать с одного вуза за проход.
# MAX_LISTS_PER_SOURCE=400

# ── Модель: уход в другие вузы ──────────────────────────────────────────────
# Код поступающего единый для всех вузов, а согласие можно держать только одно.
# Поэтому конкурент, подавший согласие в другой вуз, отсюда почти наверняка
# уйдёт — вот с какой вероятностью модель его уводит. Не 1.0 потому, что
# согласие отзывают и переподают.
# MC_CONSENT_ELSEWHERE_LEAVE=0.9
#
# А это — прежняя сценарная оценка для тех, кто не подал согласие НИГДЕ:
# ожидаемая доля уходящих из этого пула.
# MC_OPTOUT_RATIO=0.20

# ── Прочее ──────────────────────────────────────────────────────────────────
ENV=prod
TIMEZONE=Europe/Moscow

# Публикация снапшота для десктоп-клиента (scripts/publish_snapshot.sh).
# Токен GitHub — такой же секрет, как и токен бота.
# GITHUB_TOKEN=
